{
  "extends": "./tsconfig.json",
  "include": [
    "../../.github/scripts/*.mts",
    "../../plugins/codex-security/native/*.mts",
    "scripts/compare-test-reports.mts",
    "scripts/run-ci-tests.mts",
    "scripts/test-shards.mts"
  ],
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": false,
    "noEmitOnError": true,
    "incremental": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"]
  }
}
